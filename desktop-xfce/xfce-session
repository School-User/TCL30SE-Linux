#!/bin/sh
# Cyberdeck session (experimental): labwc (compositor) + XFCE panel/desktop/Thunar. Started from ~/.profile on tty1 (casper-desktop xfce).
# Installed as /usr/local/bin/xfce-session; config in /usr/local/share/xfce-deck/labwc.
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=XFCE XDG_SESSION_DESKTOP=xfce
export WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1     # compositor draws in software, as in the pocketshell session
export GSK_RENDERER=cairo MOZ_ENABLE_WAYLAND=1 SDL_VIDEODRIVER=wayland QT_QPA_PLATFORM=wayland TERMCMD=foot
[ -z "$DBUS_SESSION_BUS_ADDRESS" ] && exec dbus-run-session -- "$0" "$@"
FAST=$(for c in /sys/devices/system/cpu/cpu[0-9]*; do echo "$(cat $c/cpu_capacity 2>/dev/null || echo 0) ${c##*cpu}"; done | sort -rn | awk 'NR==1{top=$1} $1==top{printf "%s%s", (n++?",":""), $2}')
C=${XFCE_DECK_CONF:-/usr/local/share/xfce-deck/labwc}
[ -n "$FAST" ] && exec taskset -c "$FAST" labwc -C "$C"
exec labwc -C "$C"
