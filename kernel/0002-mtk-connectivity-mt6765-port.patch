diff --git c/common/common_main/linux/btif_shim.c w/common/common_main/linux/btif_shim.c
new file mode 100644
index 0000000..b41af47
--- /dev/null
+++ w/common/common_main/linux/btif_shim.c
@@ -0,0 +1,261 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * port: replacement for the vendor MediaTek BTIF driver (drivers/misc/mediatek/btif),
+ * which is not available for this tree.  BTIF is a 16550-like byte pipe between the AP
+ * and the CONNSYS MCU; mainline drives it with 8250 (PORT_MTK_BTIF, "mediatek,mtk-btif").
+ * Without a DT node we register the 8250 port here, open it in-kernel, put a tiny line
+ * discipline on it that hands received bytes to STP, and implement the 12 mtk_wcn_btif_*
+ * calls stp_btif.c makes.  No DMA (the vendor driver used APDMA); PIO is plenty for WMT.
+ *
+ * ponytail: single owner, single port; dpidle/loopback/debug calls are no-ops.
+ */
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/fs.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/irqdomain.h>
+#include <linux/kthread.h>
+#include <linux/moduleparam.h>
+#include <linux/of.h>
+#include <linux/of_irq.h>
+#include <linux/serial_8250.h>
+#include <linux/tty.h>
+#include <linux/tty_ldisc.h>
+#include <dt-bindings/clock/mt6765-clk.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "osal_typedef.h"
+#include "mtk_btif_exp.h"
+
+#define BTIF_BASE	0x1100c000	/* stock DT btif@1100c000 */
+#define BTIF_SPI	112		/* stock: <GIC_SPI 0x70 IRQ_TYPE_LEVEL_LOW> */
+#define BTIF_FAKELCR	0x0c		/* vendor: 0 = normal mode (8250 writes LCR here) */
+#define BTIF_TRI_LVL	0x60		/* vendor: TX threshold [3:0], RX threshold [6:4] */
+#define BTIF_WAK	0x64		/* vendor btif_plat: BTIF_WAK, bit0 = wake CONNSYS */
+#define BTIF_TX_THRE	8		/* vendor BTIF_TX_FIFO_SIZE 16 / 2 */
+#define BTIF_ID		1UL
+
+static struct {
+	int line;
+	struct clk *clk;
+	void __iomem *base;
+	struct file *filp;
+	struct tty_struct *tty;
+	MTK_WCN_BTIF_RX_CB rx_cb;
+	struct task_struct *rxd;	/* only so STP has a thread to name/dump */
+} sh = { .line = -1 };
+
+static bool rxdump, txdump;
+module_param(rxdump, bool, 0644);
+module_param(txdump, bool, 0644);
+
+static void shim_receive_buf(struct tty_struct *tty, const u8 *cp, const u8 *fp, size_t count)
+{
+	MTK_WCN_BTIF_RX_CB cb = READ_ONCE(sh.rx_cb);
+
+	if (rxdump)
+		print_hex_dump(KERN_INFO, "[BTIF-RX] ", DUMP_PREFIX_OFFSET, 16, 1, cp, min_t(size_t, count, 64), false);
+
+	if (cb && count)
+		cb((const PUINT8)cp, count);
+}
+
+static int shim_ldisc_open(struct tty_struct *tty)
+{
+	tty->receive_room = 65536;
+	return 0;
+}
+
+static struct tty_ldisc_ops shim_ldisc = {
+	.owner = THIS_MODULE,
+	.num = N_DEVELOPMENT,
+	.name = "mtk_btif_shim",
+	.open = shim_ldisc_open,
+	.receive_buf = shim_receive_buf,
+};
+
+static int rxd_fn(void *unused)
+{
+	while (!kthread_should_stop()) {
+		set_current_state(TASK_INTERRUPTIBLE);
+		schedule();
+	}
+	__set_current_state(TASK_RUNNING);
+	return 0;
+}
+
+static int shim_register_port(void)
+{
+	struct of_phandle_args clkspec = { .args_count = 1, .args = { CLK_IFR_BTIF } };
+	struct irq_fwspec fw = { .param_count = 3,
+				 .param = { GIC_SPI, BTIF_SPI, IRQ_TYPE_LEVEL_LOW } };
+	struct uart_8250_port up = {};
+	struct device_node *np;
+	int irq, ret;
+
+	clkspec.np = of_find_compatible_node(NULL, NULL, "mediatek,mt6765-infracfg");
+	sh.clk = clkspec.np ? of_clk_get_from_provider(&clkspec) : ERR_PTR(-ENODEV);
+	of_node_put(clkspec.np);
+	if (IS_ERR(sh.clk))
+		return PTR_ERR(sh.clk);
+	ret = clk_prepare_enable(sh.clk);
+	if (ret)
+		goto put_clk;
+
+	np = of_find_compatible_node(NULL, NULL, "mediatek,mt6577-sysirq");
+	fw.fwnode = of_fwnode_handle(np);
+	irq = np ? irq_create_fwspec_mapping(&fw) : 0;
+	of_node_put(np);
+	if (!irq) {
+		ret = -ENXIO;
+		goto off_clk;
+	}
+
+	sh.base = ioremap(BTIF_BASE, 0x1000);
+	if (!sh.base) {
+		ret = -ENOMEM;
+		goto off_clk;
+	}
+	up.port.mapbase = BTIF_BASE;
+	up.port.mapsize = 0x1000;
+	up.port.membase = sh.base;
+	up.port.irq = irq;
+	up.port.uartclk = 26000000;	/* BTIF ignores the divisor; 8250 needs a value */
+	up.port.regshift = 2;
+	up.port.iotype = UPIO_MEM32;
+	up.port.type = PORT_MTK_BTIF;
+	up.port.flags = UPF_FIXED_TYPE | UPF_FIXED_PORT;
+	/* THRE means "TX FIFO at/below threshold", not empty: the vendor driver writes
+	 * at most FIFO_SIZE - THRE bytes per THRE.  16 per THRE overflows and drops bytes. */
+	up.port.fifosize = 16;
+	up.tx_loadsz = 16 - BTIF_TX_THRE;
+	sh.line = serial8250_register_8250_port(&up);
+	if (sh.line < 0) {
+		ret = sh.line;
+		goto unmap;
+	}
+	pr_info("[BTIF-SHIM] BTIF registered as ttyS%d (irq %d)\n", sh.line, irq);
+	return 0;
+unmap:
+	iounmap(sh.base);
+	sh.base = NULL;
+off_clk:
+	clk_disable_unprepare(sh.clk);
+put_clk:
+	clk_put(sh.clk);
+	sh.clk = NULL;
+	sh.line = -1;
+	return ret;
+}
+
+INT32 mtk_wcn_btif_open(PINT8 owner, PULONG id)
+{
+	struct ktermios t;
+	char path[24];
+	int ret;
+
+	if (sh.filp)
+		return -EBUSY;
+	if (sh.line < 0) {
+		ret = shim_register_port();
+		if (ret) {
+			pr_err("[BTIF-SHIM] port register failed %d\n", ret);
+			return ret;
+		}
+		ret = tty_register_ldisc(&shim_ldisc);
+		if (ret)
+			return ret;
+	}
+	snprintf(path, sizeof(path), "/dev/ttyS%d", sh.line);
+	sh.filp = filp_open(path, O_RDWR | O_NOCTTY | O_NONBLOCK, 0);
+	if (IS_ERR(sh.filp)) {
+		ret = PTR_ERR(sh.filp);
+		sh.filp = NULL;
+		return ret;
+	}
+	sh.tty = ((struct tty_file_private *)sh.filp->private_data)->tty;
+	t = sh.tty->termios;
+	t.c_iflag = 0;
+	t.c_oflag = 0;
+	t.c_lflag = 0;
+	t.c_cflag = CS8 | CREAD | CLOCAL | B921600;
+	tty_set_termios(sh.tty, &t);
+	/* vendor hal_btif_hw_init: normal mode, TX thre 8, RX thre 1, loopback off */
+	writel(0, sh.base + BTIF_FAKELCR);
+	writel(BTIF_TX_THRE | (1 << 4), sh.base + BTIF_TRI_LVL);
+	ret = tty_set_ldisc(sh.tty, N_DEVELOPMENT);
+	if (ret) {
+		filp_close(sh.filp, NULL);
+		sh.filp = NULL;
+		return ret;
+	}
+	if (!sh.rxd)
+		sh.rxd = kthread_run(rxd_fn, NULL, "btif_rxd");
+	*id = BTIF_ID;
+	pr_info("[BTIF-SHIM] opened by %s\n", owner);
+	return 0;
+}
+
+INT32 mtk_wcn_btif_close(ULONG id)
+{
+	WRITE_ONCE(sh.rx_cb, NULL);
+	if (sh.filp)
+		filp_close(sh.filp, NULL);	/* releasing the tty drops our ldisc */
+	sh.filp = NULL;
+	sh.tty = NULL;
+	return 0;
+}
+
+INT32 mtk_wcn_btif_write(ULONG id, const PUINT8 buf, UINT32 len)
+{
+	if (!sh.tty)
+		return -ENODEV;
+	if (txdump)
+		print_hex_dump(KERN_INFO, "[BTIF-TX] ", DUMP_PREFIX_OFFSET, 16, 1, buf, min_t(u32, len, 32), false);
+	return sh.tty->ops->write(sh.tty, buf, len);
+}
+
+INT32 mtk_wcn_btif_rx_cb_register(ULONG id, MTK_WCN_BTIF_RX_CB cb)
+{
+	WRITE_ONCE(sh.rx_cb, cb);
+	return 0;
+}
+
+INT32 mtk_wcn_btif_wakeup_consys(ULONG id)
+{
+	if (!sh.base)
+		return -ENODEV;
+	writel(1, sh.base + BTIF_WAK);
+	udelay(100);
+	writel(0, sh.base + BTIF_WAK);
+	return 0;
+}
+
+INT32 mtk_wcn_btif_dpidle_ctrl(ULONG id, enum _ENUM_BTIF_DPIDLE_ en) { return 0; }
+INT32 mtk_wcn_btif_loopback_ctrl(ULONG id, enum _ENUM_BTIF_LPBK_MODE_ en) { return 0; }
+INT32 mtk_wcn_btif_dbg_ctrl(ULONG id, enum _ENUM_BTIF_DBG_ID_ flag) { return 0; }
+MTK_WCN_BOOL mtk_wcn_btif_parser_wmt_evt(ULONG id, const PUINT8 str, UINT32 len) { return 0; }
+INT32 mtk_btif_exp_rx_has_pending_data(ULONG id) { return 0; }
+INT32 mtk_btif_exp_tx_has_pending_data(ULONG id)
+{
+	return sh.tty ? tty_chars_in_buffer(sh.tty) > 0 : 0;
+}
+struct task_struct *mtk_btif_exp_rx_thread_get(ULONG id) { return sh.rxd; }
+
+void btif_shim_exit(void)
+{
+	mtk_wcn_btif_close(BTIF_ID);
+	if (sh.rxd)
+		kthread_stop(sh.rxd);
+	sh.rxd = NULL;
+	if (sh.line >= 0) {
+		tty_unregister_ldisc(&shim_ldisc);
+		serial8250_unregister_port(sh.line);
+		iounmap(sh.base);
+		clk_disable_unprepare(sh.clk);
+		clk_put(sh.clk);
+		sh.line = -1;
+	}
+}
diff --git c/common/common_main/linux/include/mtk_btif_exp.h w/common/common_main/linux/include/mtk_btif_exp.h
new file mode 100644
index 0000000..371fca2
--- /dev/null
+++ w/common/common_main/linux/include/mtk_btif_exp.h
@@ -0,0 +1,66 @@
+/*
+ * Copyright (C) 2016 MediaTek Inc.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
+ * published by the Free Software Foundation.
+ *
+ * Minimal stand-in for the vendor BTIF export header.
+ *
+ * The Bluetooth half of the combo is not ported: common_main/linux/stp_btif.c
+ * needs the separate MediaTek "btif" driver (drivers/misc/mediatek/btif/),
+ * which is not part of this import, so that object is left out of the build
+ * (see common/Makefile).  btm_core.h and stp_btif.h still include this header
+ * for the shared types, and the STP/BTM core uses the RX callback type, so
+ * only the types and the few constants those headers reference are defined
+ * here.  Nothing in the WLAN path depends on the missing functions.
+ */
+
+#ifndef _MTK_BTIF_EXP_H_
+#define _MTK_BTIF_EXP_H_
+
+#include "osal_typedef.h"
+
+/* STP hands this callback to the BTIF RX path (see mtk_wcn_stp_rxcb_register). */
