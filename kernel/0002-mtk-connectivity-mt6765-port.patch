diff --git c/common/common_main/platform/mtk_wcn_consys_rmem.c w/common/common_main/platform/mtk_wcn_consys_rmem.c
new file mode 100644
index 0000000..cd03e01
--- /dev/null
+++ w/common/common_main/platform/mtk_wcn_consys_rmem.c
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Reserved-memory allocator for the MediaTek CONNSYS EMI region.
+ *
+ * The vendor kernel carried this in its reserved-memory driver.  Without a
+ * driver bound to "mediatek,consys-reserve-memory" the dynamic node is not
+ * registered, so of_reserved_mem_lookup() in mtk_wcn_consys_hw.c fails and
+ * CONNSYS has no EMI base address for firmware download.
+ *
+ * The core performs the allocation described by size/alignment/alloc-ranges;
+ * this only needs to claim the compatible and log the result.
+ */
+#include <linux/init.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/device.h>
+
+static int consys_reserve_mem_device_init(struct reserved_mem *rmem,
+					  struct device *dev)
+{
+	dev_info(dev, "CONNSYS EMI region %pa size 0x%zx\n", &rmem->base,
+		 rmem->size);
+	return 0;
+}
+
+static const struct reserved_mem_ops consys_reserve_mem_ops = {
+	.device_init = consys_reserve_mem_device_init,
+};
+
+RESERVEDMEM_OF_DECLARE(consys_reserve_mem, "mediatek,consys-reserve-memory",
+		       &consys_reserve_mem_ops);
