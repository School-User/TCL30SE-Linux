#!/usr/bin/python3
# Build Pocket's ad/tracker blocklist (WebKit content-blocker JSON) from Peter Lowe's list.
import json, os, re, sys, urllib.request
URL = "https://pgl.yoyo.org/adservers/serverlist.php?hostformat=nohtml&showintro=0&mimetype=plaintext"
out = os.path.expanduser("~/.local/share/pocket/blocklist.json")
hosts = [h.strip() for h in urllib.request.urlopen(URL, timeout=30).read().decode().split() if h.strip()]
rules = [{"trigger": {"url-filter": r"^https?://([^/]*\.)?" + re.escape(h) + "[:/]",
                      "load-type": ["third-party"]}, "action": {"type": "block"}} for h in hosts]
os.makedirs(os.path.dirname(out), exist_ok=True)
json.dump(rules, open(out, "w"))
print(len(rules), "rules ->", out)
