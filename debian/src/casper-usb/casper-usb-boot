#!/bin/sh
# Set the USB-C port role ONCE at boot from /etc/casper-usb-mode (host | host-ext | device). The musb controller jams
# (DEVCTL 0x99, stays a B-device until reboot) if the role is switched device<->host more than once, so never cycle it:
# change the mode with `casper-usb-mode <mode>` and reboot.
#   host     phone powers the port (5 V boost): any unpowered hub/dongle, keyboard, mouse. No charging.
#   host-ext boost off: a hub with its own power supplies VBUS (and charges the phone, if the hub passes power through).
#   device   laptop (SSH over USB) / plain charger.
M=$(cat /etc/casper-usb-mode 2>/dev/null || echo device)
for i in $(seq 30); do ls /sys/class/usb_role/*/role >/dev/null 2>&1 && break; sleep 1; done
# kernel with the hot-swap patch: keep the Type-C driver from flipping the role / boost on plug events
H=/sys/module/wusb3801/parameters/hold_role; [ -w $H ] && echo 1 > $H
case "$M" in host|host-ext) casper-usb "$M" ;; *) echo "USB port: device (mode $M)" ;; esac
echo "devctl=$(/usr/local/sbin/busybox-rescue devmem 0x11200060 8 2>/dev/null)"   # 0x19 = host session OK, 0x99 = jammed
