#!/usr/bin/python3
# Firefox native-messaging host "hwplay": {"url": "https://..."} -> hwplay-launch URL (detached). One message per run.
import json, os, struct, subprocess, sys

def main():
    raw = sys.stdin.buffer.read(4)
    if len(raw) < 4:
        return
    msg = json.loads(sys.stdin.buffer.read(struct.unpack("=I", raw)[0]))
    url = msg.get("url", "") if isinstance(msg, dict) else ""
    ok = isinstance(url, str) and url.startswith(("https://", "http://")) and len(url) < 4096
    if ok:
        env = dict(os.environ)
        env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")  # keep Firefox's WAYLAND_DISPLAY
        try:
            subprocess.Popen(["/usr/local/bin/hwplay-launch", url], env=env, start_new_session=True,
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except OSError:
            ok = False
    out = json.dumps({"ok": ok}).encode()
    sys.stdout.buffer.write(struct.pack("=I", len(out)) + out)
    sys.stdout.buffer.flush()

main()
