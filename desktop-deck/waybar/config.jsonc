{
  "layer": "top", "position": "top", "height": 24, "spacing": 0,
  "modules-left": ["custom/launcher", "wlr/taskbar"],
  "modules-center": ["clock"],
  "modules-right": ["cpu", "memory", "network", "pulseaudio", "custom/battery", "custom/lock"],
  "custom/launcher": { "format": " deck ", "tooltip": false,
                       "on-click": "fuzzel --config=/usr/local/share/cyberdeck/fuzzel.ini" },
  "wlr/taskbar": { "format": "{title:.16}", "on-click": "activate", "on-click-middle": "close", "tooltip-format": "{title}" },
  "clock": { "format": "{:%a %b %d  %I:%M %p}", "tooltip-format": "<tt>{calendar}</tt>" },
  "cpu": { "format": "cpu {usage:2}%", "interval": 3 },
  "memory": { "format": "mem {percentage}%", "interval": 5 },
  "network": { "interface": "wlan0", "format-wifi": "wifi {signalStrength}%", "format-disconnected": "wifi --",
               "format-ethernet": "eth", "tooltip-format": "{essid} {ipaddr}" },
  "pulseaudio": { "format": "vol {volume}%", "format-muted": "vol --", "scroll-step": 5,
                  "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" },
  "custom/battery": { "exec": "casper-battery", "interval": 30, "format": "bat {}",
                      "tooltip-format": "estimate from cell voltage (no fuel gauge); + = charging" },
  "custom/lock": { "format": " lock ", "on-click": "deck-lock", "tooltip-format": "Lock (Super+L); unlock with your password" }
}
